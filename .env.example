# Export the restricted development key from ~/.config/vgas/development.env.
# ReqLLM reads the exported variable directly.
OPENAI_API_KEY=

# Development generation settings.
VGAS_AI_MODEL=openai:gpt-6-luna
VGAS_AI_REASONING_EFFORT=none
VGAS_AI_MAX_OUTPUT_TOKENS=500

# Development embedding profile.
VGAS_EMBEDDING_MODEL=openai:text-embedding-3-small
VGAS_EMBEDDING_DIMENSIONS=1536

# Development safeguards for the feasibility slice.
# Keep live calls off until reservation and request limits are enforced.
VGAS_AI_LIVE_CALLS_ENABLED=false
VGAS_AI_DAILY_BUDGET_USD=0.25
VGAS_AI_MONTHLY_BUDGET_USD=2.00
VGAS_AI_MAX_CONCURRENT_REQUESTS=2
