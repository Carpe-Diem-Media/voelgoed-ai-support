  "custom_statements": [
    {
      "after_tables": [
        "outbound_deliveries"
      ],
      "code?": false,
      "down": "DROP FUNCTION guard_outbound_typed_intent()",
      "global?": false,
      "name": "guard_typed_intent",
      "up": "CREATE FUNCTION guard_outbound_typed_intent() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  RAISE EXCEPTION 'typed reply intent is immutable' USING ERRCODE = 'check_violation';\nEND\n$$;\n"
    },
    {
      "after_tables": [
        "outbound_deliveries"
      ],
      "code?": false,
      "down": "DROP TRIGGER outbound_deliveries_immutable_typed_intent ON outbound_deliveries",
      "global?": false,
      "name": "guard_typed_intent_trigger",
      "up": "CREATE TRIGGER outbound_deliveries_immutable_typed_intent\n  BEFORE UPDATE OF payload_digest, run_id, session_id, operation_ref, purpose,\n    visibility, ownership_epoch, assistant_epoch, binding_epoch, control_epoch,\n    deadline_at ON outbound_deliveries\n  FOR EACH ROW WHEN (OLD.payload_digest IS DISTINCT FROM NEW.payload_digest OR\n    (OLD.payload_digest IS NOT NULL AND\n     ROW(OLD.run_id, OLD.session_id, OLD.operation_ref, OLD.purpose, OLD.visibility,\n       OLD.ownership_epoch, OLD.assistant_epoch, OLD.binding_epoch, OLD.control_epoch, OLD.deadline_at)\n     IS DISTINCT FROM\n     ROW(NEW.run_id, NEW.session_id, NEW.operation_ref, NEW.purpose, NEW.visibility,\n       NEW.ownership_epoch, NEW.assistant_epoch, NEW.binding_epoch, NEW.control_epoch, NEW.deadline_at)))\n  EXECUTE FUNCTION guard_outbound_typed_intent();\n"
    }
  ],
