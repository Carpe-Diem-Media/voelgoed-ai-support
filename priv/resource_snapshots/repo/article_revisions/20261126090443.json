  "check_constraints": [
    {
      "attribute": [
        "index_epoch"
      ],
      "base_filter": null,
      "check": "index_epoch >= 0\nAND ((status = 'published' AND published_at IS NOT NULL AND index_epoch > 0\n      AND active_index_generation IS NOT NULL AND active_index_generation > 0\n      AND active_index_generation <= publication_generation AND active_index_profile_id IS NOT NULL)\n  OR (status <> 'published' AND active_index_generation IS NULL AND active_index_profile_id IS NULL\n      AND retained_index_generation IS NULL AND reindex_base_generation IS NULL\n      AND publication_expires_at IS NULL AND index_evaluation IS NULL))\nAND (retained_index_generation IS NULL OR (retained_index_generation > 0\n  AND retained_index_generation <= publication_generation AND retained_index_generation <> active_index_generation))\nAND (reindex_base_generation IS NULL OR (reindex_base_generation = active_index_generation\n  AND publication_generation > active_index_generation AND expected_current_revision_id IS NOT NULL\n  AND expected_current_revision_id = id))\n",
      "name": "article_revisions_active_index"
    },
    {
      "attribute": [
        "publication_generation"
      ],
      "base_filter": null,
      "check": "publication_generation >= 0\nAND ((publication_generation = 0 AND publication_requested_by_id IS NULL\n      AND publication_collection_epoch IS NULL AND publication_deadline_at IS NULL AND publication_profile_id IS NULL)\n  OR (publication_generation > 0 AND publication_requested_by_id IS NOT NULL\n      AND publication_collection_epoch >= 0 AND publication_collection_epoch IS NOT NULL\n      AND publication_deadline_at IS NOT NULL AND publication_profile_id IS NOT NULL\n      AND status IN ('publishing','publish_failed','revoked','published','superseded','expired')))\nAND (status NOT IN ('publishing','publish_failed') OR publication_generation > 0)\nAND (status <> 'publish_failed' OR publication_reason IS NOT NULL)\n",
      "name": "article_revisions_publication_request"
    },
    {
      "attribute": [
        "contributor_ids"
      ],
      "base_filter": null,
      "check": "created_by_id = ANY(contributor_ids) AND array_position(contributor_ids, NULL) IS NULL",
      "name": "article_revisions_contributors"
    },
    {
      "attribute": [
        "status"
      ],
      "base_filter": null,
      "check": "revision_number > 0 AND edit_version > 0 AND content_hash_version = 1\nAND content_hash ~ '^[a-f0-9]{64}$'\nAND (\n  (status IN ('draft','withdrawn') AND review_hash IS NULL AND approved_by_id IS NULL AND approved_at IS NULL)\n  OR (status = 'in_review' AND review_hash IS NOT NULL AND review_hash = content_hash AND approved_by_id IS NULL AND approved_at IS NULL)\n  OR (status IN ('approved','revoked','publishing','publish_failed','published','superseded','expired') AND review_hash IS NOT NULL AND review_hash = content_hash AND approved_by_id IS NOT NULL AND approved_at IS NOT NULL)\n)\n",
      "name": "article_revisions_editorial_lifecycle"
    }
  ],
