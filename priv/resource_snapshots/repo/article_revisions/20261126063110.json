    },
    {
      "attribute": [
        "status"
      ],
      "base_filter": null,
      "check": "revision_number > 0 AND edit_version > 0 AND content_hash_version = 1\nAND content_hash ~ '^[a-f0-9]{64}$'\nAND (\n  (status IN ('draft','withdrawn') AND review_hash IS NULL AND approved_by_id IS NULL AND approved_at IS NULL)\n  OR (status = 'in_review' AND review_hash IS NOT NULL AND review_hash = content_hash AND approved_by_id IS NULL AND approved_at IS NULL)\n  OR (status IN ('approved','revoked','publishing','publish_failed') AND review_hash IS NOT NULL AND review_hash = content_hash AND approved_by_id IS NOT NULL AND approved_at IS NOT NULL)\n)\n",
      "name": "article_revisions_editorial_lifecycle"
    }
