  "check_constraints": [
    {
      "attribute": [
        "turn_ref"
      ],
      "base_filter": null,
      "check": "ownership_epoch >= 0 AND assistant_epoch >= 0 AND binding_epoch >= 0 AND control_epoch >= 0 AND\nclaim_generation >= 0 AND attempt_count >= 0 AND watermark >= 0 AND regroup_count BETWEEN 0 AND 1 AND\nstate IN ('queued', 'running', 'retry_wait', 'completed', 'cancelled', 'superseded', 'failed') AND\n(state = 'running') = (lease_expires_at IS NOT NULL) AND\n(state = 'retry_wait') = (retry_at IS NOT NULL) AND\n(state = 'completed') = (decision IS NOT NULL) AND\n(state IN ('completed', 'cancelled', 'superseded', 'failed')) = (finished_at IS NOT NULL)\n",
      "name": "support_runs_lifecycle"
    },
    {
      "attribute": [
        "shadow_disposition"
      ],
      "base_filter": null,
      "check": "(shadow_disposition IS NULL AND typed_decision IS NULL) OR\n(shadow_disposition IS NOT NULL AND typed_decision IS NOT NULL\n  AND state = 'completed' AND decision = 'no_send' AND claim_generation > 0\n  AND jsonb_typeof(typed_decision) = 'object'\n  AND typed_decision->>'decision' IS NOT NULL\n  AND (shadow_disposition = 'local_handoff' AND typed_decision->>'decision' = 'handoff'\n    OR shadow_disposition = 'no_send' AND typed_decision->>'decision' IN ('greeting', 'clarify', 'decline')))\n",
      "name": "support_runs_shadow_completion"
    }
  ],
