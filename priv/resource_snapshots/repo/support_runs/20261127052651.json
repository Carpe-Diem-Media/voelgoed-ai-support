  "custom_statements": [
    {
      "after_tables": [
        "support_runs"
      ],
      "code?": false,
      "down": "DROP FUNCTION guard_support_run_shadow_completion()",
      "global?": false,
      "name": "guard_shadow_completion_function",
      "up": "CREATE FUNCTION guard_support_run_shadow_completion() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  RAISE EXCEPTION 'shadow completion may only be written from a running claim'\n    USING ERRCODE = 'check_violation';\nEND\n$$;\n"
    },
    {
      "after_tables": [
        "support_runs"
      ],
      "code?": false,
      "down": "DROP TRIGGER support_runs_immutable_shadow_completion ON support_runs",
      "global?": false,
      "name": "guard_shadow_completion_trigger",
      "up": "CREATE TRIGGER support_runs_immutable_shadow_completion\n  BEFORE UPDATE OF typed_decision, shadow_disposition ON support_runs\n  FOR EACH ROW\n  WHEN (OLD.state <> 'running' AND\n    (OLD.typed_decision IS DISTINCT FROM NEW.typed_decision OR\n     OLD.shadow_disposition IS DISTINCT FROM NEW.shadow_disposition))\n  EXECUTE FUNCTION guard_support_run_shadow_completion();\n"
    }
  ],
