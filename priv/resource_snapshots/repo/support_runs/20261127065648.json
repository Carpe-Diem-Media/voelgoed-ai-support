  "custom_statements": [
    {
      "after_tables": [
        "support_runs"
      ],
      "code?": false,
      "down": "DROP FUNCTION guard_support_run_shadow_completion()",
      "global?": false,
      "name": "guard_shadow_completion_function",
      "up": "CREATE FUNCTION guard_support_run_shadow_completion() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  RAISE EXCEPTION 'shadow completion may only be written from a running claim'\n    USING ERRCODE = 'check_violation';\nEND\n$$;\n"
    },
    {
      "after_tables": [
        "support_runs"
      ],
      "code?": false,
      "down": "DROP TRIGGER support_runs_immutable_shadow_completion ON support_runs",
      "global?": false,
      "name": "guard_shadow_completion_trigger",
      "up": "CREATE TRIGGER support_runs_immutable_shadow_completion\n  BEFORE UPDATE OF typed_decision, shadow_disposition ON support_runs\n  FOR EACH ROW\n  WHEN (OLD.state <> 'running' AND\n    (OLD.typed_decision IS DISTINCT FROM NEW.typed_decision OR\n     OLD.shadow_disposition IS DISTINCT FROM NEW.shadow_disposition))\n  EXECUTE FUNCTION guard_support_run_shadow_completion();\n"
    },
    {
      "after_tables": [
        "support_runs"
      ],
      "code?": false,
      "down": "DROP TRIGGER support_runs_immutable_typed_completion ON support_runs",
      "global?": false,
      "name": "guard_typed_completion",
      "up": "CREATE TRIGGER support_runs_immutable_typed_completion\n  BEFORE UPDATE OF decision, evidence_refs, context_digest, claim_generation,\n    session_id, assistant_revision_id, ownership_epoch, assistant_epoch,\n    binding_epoch, control_epoch, watermark, deadline_at ON support_runs\n  FOR EACH ROW\n  WHEN (OLD.state = 'completed' AND OLD.typed_decision IS NOT NULL AND (\n    ROW(OLD.decision, OLD.evidence_refs, OLD.context_digest, OLD.claim_generation,\n        OLD.session_id, OLD.assistant_revision_id, OLD.ownership_epoch, OLD.assistant_epoch,\n        OLD.binding_epoch, OLD.control_epoch, OLD.watermark, OLD.deadline_at)\n    IS DISTINCT FROM\n    ROW(NEW.decision, NEW.evidence_refs, NEW.context_digest, NEW.claim_generation,\n        NEW.session_id, NEW.assistant_revision_id, NEW.ownership_epoch, NEW.assistant_epoch,\n        NEW.binding_epoch, NEW.control_epoch, NEW.watermark, NEW.deadline_at)))\n  EXECUTE FUNCTION guard_support_run_shadow_completion();\n"
    }
  ],
